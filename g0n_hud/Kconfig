config G0N_HUD
    bool "g0ndev: HUD v2 en el dongle (la PC manda el framebuffer por raw HID)"
    depends on ZMK_DISPLAY && RAW_HID
    select LV_USE_IMG
    select THREAD_NAME

config G0N_HUD_NAME
    string "g0ndev: nombre de placa que devuelve la trama de version"
    depends on G0N_HUD
    default "corne" if SHIELD_EYESLASH_CORNE_CENTRAL_DONGLE
    default "sofle" if SHIELD_EYELASH_SOFLE_CENTRAL_DONGLE
    default "zmk"

config G0N_HUD_LED_FALLBACK
    bool "g0ndev: avisos de agente tambien por LED kana/compose"
    depends on G0N_HUD && ZMK_HID_INDICATORS
    default y

config G0N_HUD_SLIDE_MS
    int "g0ndev: duracion en ms del deslizamiento al entrar y salir del HUD (0 = corte seco)"
    depends on G0N_HUD
    default 0
